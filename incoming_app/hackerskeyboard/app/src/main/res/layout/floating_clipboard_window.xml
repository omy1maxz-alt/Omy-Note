<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/keyboard_background"> <LinearLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/keyboard_primary"
        android:paddingLeft="12dp"
        android:paddingRight="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Clipboard History"
            android:textColor="@color/keyboard_text_light"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/enter_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/sym_keyboard_return"
            android:tint="@color/keyboard_text_light"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Enter" />

        <ImageButton
            android:id="@+id/copy_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_copy"
            android:tint="@color/keyboard_text_light"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Copy All" />

        <ImageButton
            android:id="@+id/paste_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_paste"
            android:tint="@color/keyboard_text_light"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Paste" />

        <ImageButton
            android:id="@+id/selectallbutton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_select_all"
            android:tint="@color/keyboard_text_light"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Select All" />

        <ImageButton
            android:id="@+id/close_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/keyboard_text_light"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close" />
    </LinearLayout>

    <ListView
        android:id="@+id/clipboard_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/keyboard_background"
        android:divider="@color/keyboard_divider"
        android:dividerHeight="1dp"
        android:scrollbars="vertical" />

    <View
        android:id="@+id/resize_handle"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:background="@color/keyboard_primary" />

</LinearLayout>
